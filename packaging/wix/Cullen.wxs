<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalable de la estación Cullen (ADR-0030 D4).

  Construir en un host Windows con WiX Toolset v5 y la extensión Util:

    wix build packaging/wix/Cullen.wxs -ext WixToolset.Util.wixext \
      -d Staging=<ruta staging> -d Version=<x.y.z> -o Cullen-<x.y.z>.msi

  El staging lo prepara el script de construcción (ver packaging/README.md):
    <Staging>/server, <Staging>/app, <Staging>/runtime, <Staging>/service, <Staging>/config

  Responsabilidades: copiar binarios; crear %ProgramData%\Cullen\* con la ACL que
  assertProtectedDirectory verifica; registrar el servicio CullenNode bajo la cuenta de
  servicio virtual; agendar el respaldo operativo; instalar los accesos directos de la ventana.
  No coloca node-identity.json ni material TLS.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define Version = "$(var.Version)" ?>

  <Package Name="Cullen"
           Manufacturer="Cullen"
           Version="$(var.Version)"
           UpgradeCode="B6349886-2E7F-43A1-B849-4A77C60FBB3D"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de Cullen instalada." />
    <MediaTemplate EmbedCab="yes" />

    <!-- El servicio corre con su propia cuenta de servicio virtual, de menor privilegio. -->
    <util:User Id="CullenNodeAccount"
               Name="NT SERVICE\CullenNode"
               CreateUser="no"
               RemoveOnUninstall="no" />

    <Feature Id="Main" Title="Cullen" Level="1">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="DataDirectories" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cullen">
        <Directory Id="ServerDir" Name="server" />
        <Directory Id="AppDir" Name="app">
          <Directory Id="AppRendererDir" Name="renderer" />
        </Directory>
        <Directory Id="RuntimeDir" Name="runtime" />
        <Directory Id="ServiceDir" Name="service" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="Cullen">
        <Directory Id="DataDbDir" Name="db" />
        <Directory Id="DataBackupsDir" Name="backups" />
        <Directory Id="DataKeysDir" Name="keys" />
        <Directory Id="DataLogsDir" Name="logs" />
        <Directory Id="DataDiagnosticsDir" Name="diagnostics" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="Cullen" />
    </StandardDirectory>

    <!-- Binarios: recogidos del staging. -->
    <ComponentGroup Id="ServerFiles" Directory="ServerDir">
      <Files Include="$(var.Staging)\server\**" />
    </ComponentGroup>
    <ComponentGroup Id="AppFiles" Directory="AppDir">
      <Files Include="$(var.Staging)\app\**" />
    </ComponentGroup>
    <ComponentGroup Id="RuntimeFiles" Directory="RuntimeDir">
      <Files Include="$(var.Staging)\runtime\**" />
    </ComponentGroup>

    <!-- Servicio: WinSW como ejecutable del SCM, con su .xml al lado. -->
    <Component Id="ServiceComponent" Directory="ServiceDir" Guid="8AD3245F-32B0-4B49-9E18-0EBE2DD93C2F">
      <File Id="WinswExe" Source="$(var.Staging)\service\CullenNode.exe" KeyPath="yes" />
      <File Id="WinswXml" Source="$(var.Staging)\service\CullenNode.xml" />
      <ServiceInstall Id="CullenNodeService"
                      Name="CullenNode"
                      DisplayName="Cullen — nodo local"
                      Description="Nodo Fastify de la estación Cullen."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT SERVICE\CullenNode"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="CullenNodeControl"
                      Name="CullenNode"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- Directorio de datos: se crea vacío; la ACL la fija HardenDataDir. -->
    <Component Id="DataDirectories" Directory="DataFolder" Guid="3FE1BD97-879A-42FB-B417-F1027E54E487">
      <CreateFolder />
      <CreateFolder Directory="DataDbDir" />
      <CreateFolder Directory="DataBackupsDir" />
      <CreateFolder Directory="DataKeysDir" />
      <CreateFolder Directory="DataLogsDir" />
      <CreateFolder Directory="DataDiagnosticsDir" />
      <RegistryValue Root="HKLM" Key="Software\Cullen" Name="DataFolder" Type="string"
                     Value="[DataFolder]" KeyPath="yes" />
    </Component>

    <Component Id="AppShortcut" Directory="AppMenuDir" Guid="325D3190-3FFA-4A9B-85AB-E4D9B4DDF0AF">
      <Shortcut Id="CullenShortcut" Name="Cullen" Target="[AppDir]Cullen.exe" WorkingDirectory="AppDir" />
      <RemoveFolder Id="AppMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Cullen" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      ACL del directorio de datos (ADR-0029 D7.2). Se replica exactamente lo que
      assertProtectedDirectory acepta: SYSTEM, Administradores y la cuenta de servicio.
      `/inheritance:r` quita las ACEs heredadas (Usuarios), que es lo que el nodo rechaza.
    -->
    <SetProperty Id="HardenDataDir"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[DataFolder]&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F &quot;NT SERVICE\CullenNode&quot;:(OI)(CI)F /grant:r *S-1-3-0:(OI)(CI)F /T"
                 Before="HardenDataDir" Sequence="execute" />
    <CustomAction Id="HardenDataDir" DllEntry="WixQuietExec64" Execute="deferred"
                  Impersonate="no" Return="check" BinaryRef="Wix4UtilCA_X64" />

    <SetProperty Id="ScheduleBackup"
                 Value="&quot;[System64Folder]schtasks.exe&quot; /create /f /tn &quot;Cullen\RespaldoOperativo&quot; /tr &quot;\&quot;[RuntimeDir]node.exe\&quot; \&quot;[ServerDir]backup.js\&quot;&quot; /sc daily /st 03:30 /ru &quot;NT SERVICE\CullenNode&quot; /rl LIMITED"
                 Before="ScheduleBackup" Sequence="execute" />
    <CustomAction Id="ScheduleBackup" DllEntry="WixQuietExec64" Execute="deferred"
                  Impersonate="no" Return="ignore" BinaryRef="Wix4UtilCA_X64" />

    <SetProperty Id="RemoveBackupTask"
                 Value="&quot;[System64Folder]schtasks.exe&quot; /delete /f /tn &quot;Cullen\RespaldoOperativo&quot;"
                 Before="RemoveBackupTask" Sequence="execute" />
    <CustomAction Id="RemoveBackupTask" DllEntry="WixQuietExec64" Execute="deferred"
                  Impersonate="no" Return="ignore" BinaryRef="Wix4UtilCA_X64" />

    <InstallExecuteSequence>
      <Custom Action="HardenDataDir" After="CreateFolders" Condition="NOT REMOVE" />
      <Custom Action="ScheduleBackup" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="RemoveBackupTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>

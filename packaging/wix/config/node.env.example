# Configuración por instalación del nodo Cullen.
# Copiar a %ProgramData%\Cullen\node.env y completar por sitio.
# El servicio ya define las rutas del perímetro (ver packaging/winsw/CullenNode.xml);
# aquí van sólo las decisiones de topología. Sin este archivo el nodo arranca standalone.

# --- Standalone: no definir nada más. ---

# --- Terminal LAN (se conecta a un coordinador) ---
# SYNC_COORDINATOR_NODE_ID=
# SYNC_COORDINATOR_HOST=
# SYNC_COORDINATOR_PORT=8443
# SYNC_CLIENT_TLS_KEY_PATH=C:\ProgramData\Cullen\keys\lan\terminal.key.sealed
# SYNC_CLIENT_TLS_CERT_PATH=C:\ProgramData\Cullen\keys\lan\terminal.cert.sealed
# SYNC_CLIENT_TLS_CA_PATHS=C:\ProgramData\Cullen\keys\lan\ca.pem.sealed

# --- Coordinador (escucha en LAN) ---
# SYNC_LISTENER_HOST=0.0.0.0
# SYNC_LISTENER_PORT=8443
# SYNC_LISTENER_TLS_KEY_PATH=C:\ProgramData\Cullen\keys\lan\coordinator.key.sealed
# SYNC_LISTENER_TLS_CERT_PATH=C:\ProgramData\Cullen\keys\lan\coordinator.cert.sealed
# SYNC_LISTENER_TLS_CLIENT_CA_PATHS=C:\ProgramData\Cullen\keys\lan\ca.pem.sealed
# Durante una rotación de CA, apuntar a las dos: ...\ca.pem.sealed,...\ca-next.pem.sealed

# --- Respaldo operativo (ADR-0030 D7); opcionales, con estos valores por omisión ---
# Hora local (0-23) a la que el servicio toma la copia diaria.
# OPERATIONAL_BACKUP_HOUR=3
# OPERATIONAL_BACKUP_DAILY_RETENTION=7
# OPERATIONAL_BACKUP_WEEKLY_RETENTION=4
# Copia adicional fuera de la máquina. Sigue sellada: restaurarla exige la clave del nodo.
# OPERATIONAL_BACKUP_EXTERNAL_PATH=E:\respaldos-cullen
